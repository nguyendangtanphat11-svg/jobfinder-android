<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp"
    tools:ignore="HardcodedText">

    <!-- 1. DRAG HANDLE (Thanh kéo Bottom Sheet) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- 2. HEADER: Tiêu đề + Nút đóng -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Giới thiệu bản thân"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseBio"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#777777" />
    </RelativeLayout>

    <!-- 3. THẺ GỢI Ý MẪU Ý TƯỞNG (PROMPT SUGGESTIONS) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Gợi ý nội dung:"
        android:textColor="#666666"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupBioSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:singleLine="true">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sinh viên CNTT mới tốt nghiệp"
            android:textColor="#6B52AE"
            app:chipBackgroundColor="#F0EBFC"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yêu thích Lập trình Web/Mobile"
            android:textColor="#6B52AE"
            app:chipBackgroundColor="#F0EBFC"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mong muốn tìm môi trường học hỏi"
            android:textColor="#6B52AE"
            app:chipBackgroundColor="#F0EBFC"
            app:chipStrokeWidth="0dp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 4. KHUNG NHẬP MÔ TẢ CÓ ĐẾM KÝ TỰ -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mô tả ngắn về kinh nghiệm, mục tiêu nghề nghiệp..."
        app:boxStrokeColor="#6B52AE"
        app:counterEnabled="true"
        app:counterMaxLength="300"
        app:endIconMode="clear_text"
        app:hintTextColor="#6B52AE">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtBio"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:textColor="#222222"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 5. HÀNG NÚT THAO TÁC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Hủy"
            android:textColor="#666666"
            app:cornerRadius="24dp"
            app:strokeColor="#DDDDDD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.5"
            android:backgroundTint="#6B52AE"
            android:text="Lưu lại"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:elevation="2dp" />
    </LinearLayout>

</LinearLayout>