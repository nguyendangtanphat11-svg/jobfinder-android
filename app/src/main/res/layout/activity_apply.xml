<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="#2A174B"
        app:title="Gửi hồ sơ ứng tuyển"
        app:titleTextColor="#2A174B" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="80dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F0EBFC"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vị trí ứng tuyển" android:textColor="#655A70" android:textSize="13sp" />
                    <TextView android:id="@+id/tvApplyJobName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="#2A174B" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvApplyCompanyName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#655A70" android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E8E2F1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông tin liên hệ" android:textColor="#2A174B" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Bạn có thể chỉnh sửa thông tin cho riêng hồ sơ này." android:textColor="#766B82" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Họ và tên *" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:textColor="#282037" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Email *" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:startIconDrawable="@drawable/ic_email_24">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:textColor="#282037" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Số điện thoại *" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPhoneNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textColor="#282037" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E8E2F1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CV ứng tuyển" android:textColor="#2A174B" android:textSize="17sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/layoutUploadCV" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_dashed_border" android:clickable="true" android:contentDescription="Chọn hoặc thay CV" android:focusable="true" android:gravity="center_vertical" android:minHeight="72dp" android:orientation="horizontal" android:padding="14dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="CV" android:src="@drawable/ic_description" app:tint="#622FB5" />
                        <TextView android:id="@+id/tvCVStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textColor="#5F5569" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E8E2F1" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lời nhắn giới thiệu" android:textColor="#2A174B" android:textSize="17sp" android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Tối đa 1000 ký tự">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:maxLength="1000" android:minLines="4" android:textColor="#282037" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cbConfirmInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:text="Tôi xác nhận thông tin trong hồ sơ là chính xác." android:textColor="#4E4359" android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitApply" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="bottom" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:text="Gửi hồ sơ ứng tuyển" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="#622FB5" app:cornerRadius="14dp" />

    <FrameLayout android:id="@+id/layoutLoading" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" android:clickable="true" android:visibility="gone">
        <ProgressBar android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:indeterminateTint="@android:color/white" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
