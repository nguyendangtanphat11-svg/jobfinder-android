<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp"
    tools:ignore="HardcodedText">

    <!-- 1. DRAG HANDLE (Thanh kéo Bottom Sheet) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- 2. HEADER: Tiêu đề + Nút đóng -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Thêm kinh nghiệm làm việc"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseExp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#777777" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="500dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 3. CHỨC DANH / VỊ TRÍ -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chức danh / Vị trí *"
                app:boxStrokeColor="#6B52AE"
                app:endIconMode="clear_text"
                app:hintTextColor="#6B52AE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtJobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="#222222"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. TÊN CÔNG TY -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Tên công ty / Tổ chức *"
                app:boxStrokeColor="#6B52AE"
                app:endIconMode="clear_text"
                app:hintTextColor="#6B52AE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCompanyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="#222222"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5. CHECKBOX ĐANG LÀM VIỆC -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkCurrentJob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tôi đang làm việc tại đây"
                android:textColor="#555555"
                android:textSize="14sp"
                app:buttonTint="#6B52AE" />

            <!-- 6. THỜI GIAN (BẮT ĐẦU - KẾT THÚC) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Bắt đầu *"
                    app:boxStrokeColor="#6B52AE"
                    app:endIconDrawable="@android:drawable/ic_menu_today"
                    app:endIconMode="custom"
                    app:endIconTint="#6B52AE"
                    app:hintTextColor="#6B52AE">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#222222"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEndDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="Kết thúc *"
                    app:boxStrokeColor="#6B52AE"
                    app:endIconDrawable="@android:drawable/ic_menu_today"
                    app:endIconMode="custom"
                    app:endIconTint="#6B52AE"
                    app:hintTextColor="#6B52AE">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEndDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#222222"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 7. MÔ TẢ CÔNG VIỆC -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Mô tả công việc &amp; thành tựu"
                app:boxStrokeColor="#6B52AE"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:hintTextColor="#6B52AE">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtJobDescription"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textColor="#222222"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 8. NÚT THAO TÁC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelExp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Hủy"
            android:textColor="#666666"
            app:cornerRadius="24dp"
            app:strokeColor="#DDDDDD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveExp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.5"
            android:backgroundTint="#6B52AE"
            android:text="Lưu kinh nghiệm"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:elevation="2dp" />
    </LinearLayout>

</LinearLayout>